{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rockhound",
  "version": "0.8.0",
  "identifier": "io.github.averus89.rockhound",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Rockhound",
        "width": 480,
        "height": 640,
        "minWidth": 380,
        "minHeight": 480
      },
      {
        "label": "overlay",
        "create": false,
        "title": "Rockhound overlay",
        "width": 340,
        "height": 96,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MzBEQjEwNzRCNUZGMEQKUldRTi83VjBFTnN3NUxFRzhNVmhubTJKbm5XZzkydjVBam8xRi9IMGNmbzU0eHlnRFdHa1V0VXAK",
      "endpoints": [
        "https://github.com/Averus89/rockhound/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
